# Copier ce fichier en server/.env et renseigner les valeurs (ne jamais committer .env)

# ─── Serveur ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Base de données (PostgreSQL) ─────────────────────────────
DATABASE_URL=postgresql://primo:change_me@localhost:5432/primo

# ─── JWT ──────────────────────────────────────────────────────
# Générer chaque secret avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_me_too
JWT_REFRESH_EXPIRES_IN=30d

# ─── Stripe (mode test) ───────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# ─── CORS ─────────────────────────────────────────────────────
# Liste d'origines autorisées, séparées par des virgules
CLIENT_URL=http://localhost:3000
